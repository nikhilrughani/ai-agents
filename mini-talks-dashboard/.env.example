# ─── Firebase Admin (required for multi-user / Vercel deployment) ─────────────
#
# 1. Go to Firebase Console → your project → ⚙️ Project settings → Service accounts
# 2. Click "Generate new private key" → download the JSON file
# 3. Copy the ENTIRE JSON content (one line) into the value below
# 4. On Vercel: add this as an environment variable named FIREBASE_SERVICE_ACCOUNT
#
# Example (paste your actual JSON — keep it on one line):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}
FIREBASE_SERVICE_ACCOUNT=

# ─── Local / single-user dev mode (no Firebase required) ─────────────────────
# If FIREBASE_SERVICE_ACCOUNT is empty, the server uses these env vars instead.
# Useful for running locally without a Firebase project.
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
# DATA_SOURCE=notion   # or: sheets
# SHEETS_URL=https://docs.google.com/spreadsheets/d/...

# ─── Server port (optional, defaults to 3000) ─────────────────────────────────
PORT=3000
