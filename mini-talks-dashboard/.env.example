# ─── Firebase (required for multi-user / Vercel deployment) ──────────────────
# Just your Firebase project ID — no service account or secret key needed.
# Found in Firebase Console → Project settings → General → Project ID
FIREBASE_PROJECT_ID=mini-talks-dashboard

# ─── App URL (used in share links and welcome emails) ─────────────────────────
# Set to your Vercel deployment URL (no trailing slash)
APP_URL=https://your-project.vercel.app

# ─── Welcome email via Resend (optional) ─────────────────────────────────────
# Get a free key at resend.com (3,000 emails/month free)
# If not set, welcome emails are silently skipped
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=hello@yourdomain.com

# ─── Stripe payments (optional — infrastructure ready, not yet enforced) ──────
# Leave blank to keep everything free. Set all three to activate paid plans.
# Create a product + price at dashboard.stripe.com, then:
#   STRIPE_SECRET_KEY    = sk_live_... (or sk_test_... for testing)
#   STRIPE_WEBHOOK_SECRET = whsec_... (from Stripe dashboard → Webhooks)
#   STRIPE_PRICE_ID       = price_... (the recurring price for your plan)
#
# To enforce payment gating, also set:
#   ENFORCE_PLAN=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ENFORCE_PLAN=

# ─── Local / single-user dev mode (no Firebase required) ─────────────────────
# If FIREBASE_PROJECT_ID is empty, the server skips auth and uses these instead.
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
# DATA_SOURCE=notion   # or: sheets
# SHEETS_URL=https://docs.google.com/spreadsheets/d/...

PORT=3000
