# ─── Firebase (required for multi-user / Vercel deployment) ──────────────────
# Just your Firebase project ID — no service account or secret key needed.
# Found in Firebase Console → Project settings → General → Project ID
FIREBASE_PROJECT_ID=mini-talks-dashboard

# ─── Local / single-user dev mode (no Firebase required) ─────────────────────
# If FIREBASE_PROJECT_ID is empty, the server skips auth and uses these instead.
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
# DATA_SOURCE=notion   # or: sheets
# SHEETS_URL=https://docs.google.com/spreadsheets/d/...

PORT=3000
