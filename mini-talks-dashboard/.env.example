# ─── Firebase Configuration ──────────────────────────────────────────────────
# These values are used by the Firebase CLI tools.
# The Firebase JS SDK config is auto-injected by Firebase Hosting (/__/firebase/init.js).
# You do NOT need to hardcode these in any HTML file.
#
# To get your project ID:
#   firebase projects:list
#
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Local Development (optional) ────────────────────────────────────────────
# Run `firebase emulators:start` to use local emulators on port 5000.
# No .env file is needed for local development — the Firebase Emulator Suite
# handles all configuration automatically.

# ─── Legacy (no longer used) ─────────────────────────────────────────────────
# The old server.js read NOTION_TOKEN and NOTION_DATABASE_ID from .env.
# With Firebase Auth, all Notion credentials are stored per-user in Firestore.
# No server-level secrets are needed.
