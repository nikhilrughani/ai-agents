rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user owns their own subtree (guests, credentials, share config, plan)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public share snapshots — readable by anyone who has the share URL.
    // The more-specific rule overrides the auth requirement above for reads only.
    match /users/{userId}/publicSnapshot/{doc} {
      allow read: if true;
      // writes still require the owner's auth (covered by the rule above)
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
